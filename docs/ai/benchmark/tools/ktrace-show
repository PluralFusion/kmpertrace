#!/usr/bin/env python3
# Prototype of a proposed "kmpertrace-cli print --trace-id ID": prints one trace tree.
import subprocess, sys
f, tid = sys.argv[1], sys.argv[2]
out = subprocess.run(["kmpertrace-cli", "print", "--file", f, "--span-attrs", "on", "--color", "off"], capture_output=True, text=True).stdout
blocks, cur = [], []
for line in out.splitlines():
    if line.startswith("trace "):
        if cur: blocks.append(cur)
        cur = [line]
    elif cur is not None: cur.append(line)
if cur: blocks.append(cur)
for b in blocks:
    if b[0].split()[1].startswith(tid): print("\n".join(b))
